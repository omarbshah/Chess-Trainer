# Personal Lichess API token — create one at:
# https://lichess.org/account/oauth/token
# The puzzle dashboard/activity endpoints need a token scoped to your own account;
# public endpoints work without one.
LICHESS_API_TOKEN=

# Gemini API key — create one at https://aistudio.google.com/apikey
# One of /api/explain's provider-fallback router options. Optional — the router only tries
# providers with a key configured, and works with any subset of these set (or none, if Ollama
# is running locally).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# DeepSeek API key — create one at https://platform.deepseek.com/api_keys
# Another provider-fallback router option; optional, same as above.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Groq API key — create one at https://console.groq.com/keys
# Another provider-fallback router option; optional, same as above.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama — the local fallback provider. No API key: it's whatever's running on this URL.
# Only works if Ollama is installed and this model has been pulled (`ollama pull llama3.2`).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
