# Personal Lichess API token — create one at:
# https://lichess.org/account/oauth/token
# The puzzle dashboard/activity endpoints need a token scoped to your own account;
# public endpoints work without one.
LICHESS_API_TOKEN=

# Gemini API key — create one at https://aistudio.google.com/apikey
# Used as one of the provider-fallback router's AI puzzle explainers; optional, only needed
# once /api/explain is wired up (a later commit).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
